@article{sadegh-zadeh_2024-NeuralReshapingPlasticity,
  title = {Neural Reshaping: The Plasticity of Human Brain and Artificial Intelligence in the Learning Process},
  shorttitle = {Neural Reshaping},
  author = {Sadegh-Zadeh, Seyed-Ali and Bahrami, Mahboobe and Soleimani, Ommolbanin and Ahmadi, Sahar},
  date = {2024-12-25},
  journaltitle = {American Journal of Neurodegenerative Disease},
  shortjournal = {Am. J. Neurodegener. Dis.},
  volume = {13},
  number = {5},
  eprint = {39850545},
  eprinttype = {pubmed},
  pages = {34--48},
  issn = {2165-591X},
  doi = {10.62347/NHKD7661},
  url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC11751442/},
  urldate = {2026-08-24},
  abstract = {This study explores the concept of neural reshaping and the mechanisms through which both human and artificial intelligence adapt and learn. Objectives: To investigate the parallels and distinctions between human brain plasticity and artificial neural network plasticity, with a focus on their learning processes. Methods: A comparative analysis was conducted using literature reviews and machine learning experiments, specifically employing a multi-layer perceptron neural network to examine regression and classification problems. Results: Experimental findings demonstrate that machine learning models, similar to human neuroplasticity, enhance performance through iterative learning and optimization, drawing parallels in strengthening and adjusting connections. Conclusions: Understanding the shared principles and limitations of neural and artificial plasticity can drive advancements in AI design and cognitive neuroscience, paving the way for future interdisciplinary innovations.},
  pmcid = {PMC11751442}
}

@article{spicer_2019-WhatDoesMind,
  title = {What Does the Mind Learn? {{A}} Comparison of Human and Machine Learning Representations},
  shorttitle = {What Does the Mind Learn?},
  author = {Spicer, Jake and Sanborn, Adam N},
  date = {2019-04-01},
  journaltitle = {Current Opinion in Neurobiology},
  shortjournal = {Curr. Opin. Neurobiol.},
  series = {Machine {{Learning}}, {{Big Data}}, and {{Neuroscience}}},
  volume = {55},
  pages = {97--102},
  issn = {0959-4388},
  doi = {10.1016/j.conb.2019.02.004},
  url = {https://www.sciencedirect.com/science/article/pii/S095943881830103X},
  urldate = {2026-08-24},
  abstract = {We present a brief review of modern machine learning techniques and their use in models of human mental representations, detailing three notable branches: spatial methods, logical methods and artificial neural networks. Each of these branches contains an extensive set of systems, and demonstrate accurate emulations of human learning of categories, concepts and language, despite substantial differences in operation. We suggest that continued applications will allow cognitive researchers the ability to model the complex real-world problems where machine learning has recently been successful, providing more complete behavioural descriptions. This will, however, also require careful consideration of appropriate algorithmic constraints alongside these methods in order to find a combination which captures both the strengths and weaknesses of human cognition.}
}

