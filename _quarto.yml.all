project:
  type: book
  resources:
    - CNAME               # Added to ensure your domain file is kept during rendering
  output-dir: _book

title-en: "Harnessing Intelligence:<br/><small>AI Game Playbook</small>"

# Main book metadata in Traditional Chinese
book:
  title: "框智格局"
  subtitle: "<small>AI 人生賽局手冊</small>"
  cover-image: cover.png
  cover-image-alt: "Book cover showing the Illustrations of Alice and the Dodo from Alice's Adventures in Wonderland, by John Tenniel (1865)"  
  author:
    - name: "廖漢騰 (Han-Teng Liao)"
      orcid: "0000-0003-1081-5599"   # replace with actual ORCID
      affiliations: "獨立研究者"
  date: "2026-07-23"   # ISO format so it parses/localizes correctly across formats
  site-url: "https://book.frmai.help"   # matches CNAME; update if the domain changes
  sidebar:
    style: docked
    collapse-level: 1
  search: true
  page-navigation: true
  reader-mode: true
  chapters:
    - index.qmd
    - 00-02-notes-mental_fill-in.qmd
    - 00-03-notes-constructive_fill-in.qmd
    - toc.qmd  # This page will display the full TOC/Listings
    - part: "01----problematics.qmd"
      chapters:
        - 01-01-Turing_Test.qmd # id: sec-turing-test
        - 01-02-Chinese_Room.qmd # id: sec-chinese-room
        - 01-03-Symbol_Grounding_Problem.qmd # id: sec-symbol-grounding-problem
        - 01-04-Frame_Problem.qmd # id: sec-frame-problem
        - 01-05-Gestalt_Psychology.qmd # id: sec-gestalt-psychology
        - 01-06-Alignment_Control_Problem.qmd # id: sec-alignment-control-problem
        - 01-07-Language_Games.qmd # id: sec-language-games
    - part: 02----schools_paradigms.qmd
      chapters:
        - 02-01-symbolic_ai.qmd # id: sec-symbolic-ai
        - 02-02-statistical_ai.qmd # id: sec-statistical-ai
        - 02-03-neurosymbolic_ai.qmd # id: sec-neurosymbolic-ai
        - 02-04-agi.qmd # id: sec-agi
        - 02-05-connectionism.qmd # id: sec-connectionism
        - 02-06-behaviorism.qmd # id: sec-behaviorism
        - 02-07-large_language_models.qmd # id: sec-large-language-models
    - part: 03----symbolic_ai.qmd
      chapters:
        - 03-01-formal_logic.qmd # id: sec-formal-logic
        - 03-02-automatic_dialogue_systems.qmd # id: sec-automatic-dialogue-systems
        - 03-03-expert_systems.qmd # id: sec-expert-systems
        - 03-04-knowledge_representation.qmd # id: sec-knowledge-representation
        - 03-05-knowledge_graph.qmd # id: sec-knowledge-graph
        - 03-06-semantic_web.qmd # id: sec-semantic-web
        - 03-07-ontology.qmd # id: sec-ontology
    - part: 04----statistical_ai.qmd
      chapters:
        - 04-01-probabilistic_association.qmd # id: sec-probabilistic-association
        - 04-02-llm_chatbots.qmd # id: sec-llm-chatbots
        - 04-03-neural_networks.qmd # id: sec-neural-networks
        - 04-04-feature_engineering.qmd # id: sec-feature-engineering
        - 04-05-machine_learning_models.qmd # id: sec-machine-learning-models
        - 04-06-llm_webassembly.qmd # id: sec-llm-webassembly
        - 04-07-vector_space.qmd # id: sec-vector-space
    - part: 05----ai_orientations.qmd
      chapters:
        - 05-01-oriented_task.qmd # id: sec-oriented-task
        - 05-02-oriented_tool.qmd # id: sec-oriented-tool
        - 05-03-oriented_agent.qmd # id: sec-oriented-agent
        - 05-04-oriented_collaborative.qmd # id: sec-oriented-collaborative
        - 05-05-oriented_governance.qmd # id: sec-oriented-governance
    - part: 06----analytics_decisions.qmd
      chapters:
        - 06-01-analysis_diagnostic.qmd # id: sec-analysis-diagnostic
        - 06-02-analysis_predictive.qmd # id: sec-analysis-predictive
        - 06-03-analysis_prescriptive.qmd # id: sec-analysis-prescriptive
        - 06-04-analysis_descriptive.qmd # id: sec-analysis-descriptive
        - 06-05-analysis_generative.qmd # id: sec-analysis-generative
        - 06-06-decision_making_algorithm.qmd # id: sec-decision-making-algorithm
    - part: 07----game_ai.qmd
      chapters:
        - 07-01-ieee_micromouse.qmd # id: sec-ieee-micromouse
        - 07-02-atari_dqn.qmd # id: sec-atari-dqn
        - 07-03-alphago.qmd # id: sec-alphago
        - 07-04-poker_ai.qmd # id: sec-poker-ai
        - 07-05-openai_five.qmd # id: sec-openai-five
        - 07-06-werewolf_ai.qmd # id: sec-werewolf-ai
        - 07-07-complex_strategic_simulation.qmd # id: sec-complex-strategic-simulation
    - part: 08----embodied_ai.qmd
      chapters:
        - 08-01-robotics_and_physical_actuation.qmd # id: sec-robotics-and-physical-actuation
        - 08-02-perception_and_environment.qmd # id: sec-perception-and-environment
        - 08-03-adaptive_robotics.qmd # id: sec-adaptive-robotics
        - 08-04-human_robot_interaction.qmd # id: sec-human-robot-interaction
        - 08-05-robot_safety_and_robustness.qmd # id: sec-robot-safety-and-robustness
        - 08-06-robot_tasks_and_goals.qmd # id: sec-robot-tasks-and-goals
    - part: 09----ai_math.qmd
      chapters:
        - 09-01-collaborative_filtering.qmd # id: sec-collaborative-filtering
        - 09-02-steepest_descent_method.qmd # id: sec-steepest-descent-method
        - 09-03-bayesian_network.qmd # id: sec-bayesian-network
        - 09-04-sparse_modeling.qmd # id: sec-sparse-modeling
        - 09-05-markov_modeling.qmd # id: sec-markov-modeling
        - 09-06-monte_carlo_tree_search.qmd # id: sec-monte-carlo-tree-search
        - 09-07-hebb_rule.qmd # id: sec-hebb-rule
        - 09-08-multi_agent_payoff_matrix.qmd # id: sec-multi-agent-payoff-matrix
    - part: 10----ai_engineering.qmd
      chapters:
        - 10-01-API_MCP.qmd # id: sec-api-mcp
        - 10-02-agent_reliability_evaluation.qmd # id: sec-agent-reliability-evaluation
        - 10-03-prompt_engineering.qmd # id: sec-prompt-engineering
        - 10-04-retrieval_augmented_generation.qmd # id: sec-retrieval-augmented-generation
        - 10-05-context_engineering.qmd # id: sec-context-engineering
        - 10-06-AI_PM.qmd # id: sec-ai-pm
  appendices:
    - appendix-action.qmd # id: app-action
    - appendix-brain.qmd # id: app-brain
    - appendix-cognitive_capacity.qmd # id: app-cognitive-capacity
    - appendix-cognitive_capacity-define.qmd # id: sec-cc-define-module
    - appendix-cognitive_capacity-mvp.qmd # id: sec-cc-mvp-module
    - appendix-differentiating_API-MCP.qmd # id: app-api
    - appendix-evolving_mindmap.qmd # id: fig-mindmap
    - appendix-framing_cover_back.qmd # id: sec-cover-back
    - appendix-glossary.qmd # id: sec-book-glossary
    - references.qmd # id: sec-book-references

page-footer:
  left: |
    《框智格局：AI 賽局手冊》
     (預印版) Han-Teng Liao
  right: |
    别名《道／盜智格局：AI 賽局手冊》
    本站使用 <a href="https://quarto.org/">Quarto</a> 製作。
page-footer-en:
  left: |
     🙶Harnessing Intelligence: AI Game Playbook🙷 
     © Han-Teng Liao
  right: |
    aka  🙶The Tao of Intelligence: AI Game Playbook🙷 
    This book website is built by using <a href="https://quarto.org/">Quarto</a>.



bibliography: references.bib

# Set Traditional Chinese as main language, English as secondary
babelquarto:
  mainlanguage: 'zh-hant'
  languages: ['en']
  languagecodes:
    - name: zh-hant
      text: "繁體中文"
    - name: en
      text: "English"
  render_missing: false  # <--- CRITICAL: Prevents babelquarto from queuing main Chinese files in English pass

lang: zh-hant
language: _language-zh-hant.yml 

# Main book metadata in Traditional Chinese
format:
  html:
    lang: zh-hant
    css: styles.css
    theme:
      - zephyr                         # 或是你原本使用的基礎主題（如 default, slate 等）
      - styles-en.scss                 # 載入你專為英文版設計的 SCSS 檔案
    toc: true
    toc-location: right
    number-sections: true
    number-depth: 4
    grid:
      sidebar-width: 280px    # Widened to give long English chapter titles room
      body-width: 9000px       # Comfortable reading area for technical prose
      margin-width: 260px     # Keeps the Right TOC perfectly stable and distinct
      gutter-width: 1.5rem    # The air/padding between your three columns
